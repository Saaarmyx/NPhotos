# ============================================================
# .gitignore para proyecto Flutter
# Soporte: Dart / Flutter / Android / iOS / Linux / Windows / Web
# Sistema operativo: macOS / Windows / Linux
# Editores: VS Code / Android Studio / IntelliJ / Vim / Emacs
# ============================================================

# ------------------------------------------------------------
# 1. Flutter / Dart / Pub
# ------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.flutter-sdk-version
# pubspec.lock se versiona en APPS, se ignora solo en PACKAGES.
# Descomenta la siguiente línea si es un PACKAGE y no una APP:
# pubspec.lock

# Build y salidas generadas
/build/
**/doc/api/
/coverage/
.widget_preview/

# Archivos de símbolos y ofuscación
app.*.symbols
app.*.map.json

# Configuración local de Flutter
.local_properties/

# ------------------------------------------------------------
# 2. Android
# ------------------------------------------------------------
# Build de Gradle y Android Studio
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/app/build/
/android/build/
/android/captures/
/android/local.properties
/android/*.iml

# Firma release - NO subir claves
android/key.properties
*.jks
*.keystore
*.p12

# Archivos compilados Java / Kotlin
*.class
*.dex
*.apk
*.aab
*.ap_
*.aar

# ------------------------------------------------------------
# 3. iOS / macOS / Xcode
# ------------------------------------------------------------
# Aunque este proyecto no incluya ios/, se deja por compatibilidad Flutter
/ios/Flutter/.last_build_id
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Pods/
ios/.generated/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
*.xcworkspace
*.xcodeproj
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.mobileprovision
*.xcuserstate
*.xccheckout
*.moved-aside
Carthage/Build/

# macOS (carpeta macos/ en Flutter)
/macos/Flutter/GeneratedPluginRegistrant.swift
/macos/Flutter/Flutter-Release.xcconfig
/macos/Flutter/Flutter-Debug.xcconfig

# ------------------------------------------------------------
# 4. Linux (soporte Flutter desktop)
# ------------------------------------------------------------
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugin_registrant.h
/linux/flutter/generated_plugins.cmake
/linux/build/

# ------------------------------------------------------------
# 5. Windows (soporte Flutter desktop)
# ------------------------------------------------------------
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake
/windows/build/

# Archivos de Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
*.vcxproj.filters
Debug/
Release/
x64/
x86/
[Bb]in/
[Oo]bj/

# ------------------------------------------------------------
# 6. Web
# ------------------------------------------------------------
/web/build/
lib/generated_plugin_registrant.dart

# ------------------------------------------------------------
# 7. Sistema Operativo - macOS
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop

# ------------------------------------------------------------
# 8. Sistema Operativo - Windows
# ------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.cab
*.msi
*.msm
*.msp

# ------------------------------------------------------------
# 9. Sistema Operativo - Linux
# ------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ------------------------------------------------------------
# 10. Editores - VS Code
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ------------------------------------------------------------
# 11. Editores - IntelliJ / Android Studio
# ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
*.iws.old
out/
.idea_modules/

# ------------------------------------------------------------
# 12. Editores - Vim / Emacs / Otros
# ------------------------------------------------------------
*.swp
*.swo
*.swn
*~
\#*\#
.\#*
\#*#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# ------------------------------------------------------------
# 13. Python (si usas scripts o venv junto a Flutter)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/

# ------------------------------------------------------------
# 14. Dart / Flutter - Tests y Análisis
# ------------------------------------------------------------
/coverage/
.test_cache/
test/coverage_helper_test.dart

# ------------------------------------------------------------
# 15. Misceláneo
# ------------------------------------------------------------
*.log
*.bak
*.tmp
*.temp
*.orig
*.rej
*.svg.bak
[Tt]emp/
[Cc]ache/
node_modules/
.svn/
migrate_working_dir/
.build/
.buildlog/

# Empaquetado Debian / Linux (ej. packaging/, *.deb)
/packaging/output/
*.deb
*.rpm
*.snap

# Archivos sensibles / entorno
.env
.env.*
!.env.example
key.properties
google-services.json
GoogleService-Info.plist
*.pem
*.mobileprovision
secrets/
