# ============================================================
# .gitignore — NPhotos (Flutter)
# Soporta: Android, Linux desktop
# Sistema operativo: macOS, Windows, Linux
# Editores: VS Code, Android Studio / IntelliJ, Vim, Sublime
# ============================================================

# ------------------------------------------------------------
# 1. Flutter / Dart — núcleo
# ------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.flutter-sdk-version
.local_properties/

# Salidas de compilación de Flutter (los artefactos finales
# viven en compilaciones/, ver sección 10).
/build/
**/doc/api/
app.*.symbols
app.*.map.json

# NOTA: en APPS el pubspec.lock SÍ se versiona (builds reproducibles).
# Solo se ignoraría en PACKAGES puros.

# ------------------------------------------------------------
# 2. Android (Gradle + firma + binarios)
# ------------------------------------------------------------
/android/.gradle/
/android/build/
/android/app/build/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/captures/
/android/local.properties
/android/*.iml

# Firma release y almacenes de claves — NUNCA subir al repo.
android/key.properties
*.jks
*.keystore
*.p12

# Compilados Java/Kotlin y empaquetados Android.
*.class
*.dex
*.apk
*.aab
*.ap_
*.aar

# ------------------------------------------------------------
# 3. Linux desktop (Flutter)
# ------------------------------------------------------------
/linux/build/
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugin_registrant.h
/linux/flutter/generated_plugins.cmake

# ------------------------------------------------------------
# 4. Windows desktop (Flutter + Visual Studio)
# ------------------------------------------------------------
/windows/build/
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake
.vs/
*.user
*.suo
*.vcxproj.filters

# ------------------------------------------------------------
# 5. iOS / macOS (plantilla Flutter, por compatibilidad)
# ------------------------------------------------------------
/ios/Flutter/.last_build_id
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Pods/
ios/.generated/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
*.xcworkspace
*.xcodeproj
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.mobileprovision
/macos/Flutter/GeneratedPluginRegistrant.swift
/macos/Flutter/Flutter-Release.xcconfig
/macos/Flutter/Flutter-Debug.xcconfig

# ------------------------------------------------------------
# 6. Web (solo salidas; los iconos/fuentes de web/ SÍ se versionan)
# ------------------------------------------------------------
/web/build/
lib/generated_plugin_registrant.dart

# ------------------------------------------------------------
# 7. Sistema operativo — macOS
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ------------------------------------------------------------
# 8. Sistema operativo — Windows
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------
# 9. Sistema operativo — Linux
# ------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------
# 10. Nexora / NPhotos — compilaciones y packaging
# ------------------------------------------------------------
# Salidas por canal: compilaciones/apk|deb/release|beta|debug/
compilaciones/
/packaging/output/
*.deb
*.rpm
*.snap
*.msi
*.cab

# ------------------------------------------------------------
# 11. Editores — VS Code
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ------------------------------------------------------------
# 12. Editores — Android Studio / IntelliJ
# ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
out/

# ------------------------------------------------------------
# 13. Editores — Vim / Sublime / otros
# ------------------------------------------------------------
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
*~

# ------------------------------------------------------------
# 14. Python (scripts de packaging/icons) y cachés
# ------------------------------------------------------------
venv/
.venv/
__pycache__/
*.py[cod]

# ------------------------------------------------------------
# 15. Cobertura, tests y misceláneo
# ------------------------------------------------------------
/coverage/
.test_cache/
*.log
*.tmp
*.bak
node_modules/

# ------------------------------------------------------------
# 16. Secretos y entorno — NUNCA subir al repo
# ------------------------------------------------------------
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
*.pem
secrets/
