# ============================================================
# .gitignore — NPhotos (Flutter)
# Plataformas objetivo: Android, Linux desktop
# Sistema operativo de trabajo: Linux, macOS o Windows (el repo se
# puede editar desde cualquiera; solo se compila para las de arriba).
# Editores: VS Code, Android Studio / IntelliJ, Vim, Sublime
# ============================================================

# ------------------------------------------------------------
# 1. Flutter / Dart — núcleo
# ------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.flutter-sdk-version
.local_properties/

# Salidas de compilación de Flutter (los artefactos finales
# viven en compilaciones/, ver sección 10).
/build/
**/doc/api/
app.*.symbols
app.*.map.json

# NOTA: en APPS el pubspec.lock SÍ se versiona (builds reproducibles).
# Solo se ignoraría en PACKAGES puros.

# ------------------------------------------------------------
# 2. Android (Gradle + firma + binarios)
# ------------------------------------------------------------
/android/.gradle/
/android/build/
/android/app/build/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/captures/
/android/local.properties
/android/*.iml

# Firma release y almacenes de claves — NUNCA subir al repo.
android/key.properties
*.jks
*.keystore
*.p12

# Compilados Java/Kotlin y empaquetados Android.
*.class
*.dex
*.apk
*.aab
*.ap_
*.aar

# ------------------------------------------------------------
# 3. Linux desktop (Flutter)
# ------------------------------------------------------------
/linux/build/
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugin_registrant.h
/linux/flutter/generated_plugins.cmake

# ------------------------------------------------------------
# 4. Web (solo salidas; los iconos/fuentes de web/ SÍ se versionan)
# ------------------------------------------------------------
/web/build/
lib/generated_plugin_registrant.dart

# ------------------------------------------------------------
# 5. Sistema operativo — macOS
#    La app NO compila para macOS: estas reglas existen solo porque
#    el repo se edita desde un Mac y `.DS_Store` ensuciaría el diff.
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ------------------------------------------------------------
# 6. Sistema operativo — Windows
#    Igual que antes: solo ruido de Explorer al editar el repo.
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------
# 7. Sistema operativo — Linux
# ------------------------------------------------------------
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------
# 8. Nexora / NPhotos — compilaciones y packaging
# ------------------------------------------------------------
# Salidas por canal: compilaciones/apk|deb/release|beta|debug/
compilaciones/
/packaging/output/
*.deb
*.rpm
*.snap
*.msi
*.cab

# ------------------------------------------------------------
# 9. Editores — VS Code
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ------------------------------------------------------------
# 10. Editores — Android Studio / IntelliJ
# ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
out/

# ------------------------------------------------------------
# 11. Editores — Vim / Sublime / otros
# ------------------------------------------------------------
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
*~

# ------------------------------------------------------------
# 12. Python (scripts de packaging/icons) y cachés
# ------------------------------------------------------------
venv/
.venv/
__pycache__/
*.py[cod]

# ------------------------------------------------------------
# 13. Cobertura, tests y misceláneo
# ------------------------------------------------------------
/coverage/
.test_cache/
*.log
*.tmp
*.bak
node_modules/

# ------------------------------------------------------------
# 14. Secretos y entorno — NUNCA subir al repo
# ------------------------------------------------------------
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
*.pem
secrets/
